<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Planet Saturnus: gradasi aurora cyan → indigo → violet -->
    <path android:pathData="M37,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="37"
                android:endX="71"
                android:endY="71"
                android:type="linear">
                <item android:color="#FF41E3FA" android:offset="0.0" />
                <item android:color="#FF6C7BFF" android:offset="0.52" />
                <item android:color="#FFB48CFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cincin Saturnus (dimiringkan -18°, digambar di atas planet, gaya flat modern) -->
    <group
        android:rotation="-18"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:pathData="M28,54 a26,8.5 0 1,0 52,0 a26,8.5 0 1,0 -52,0"
            android:strokeColor="#FFD9F6FF"
            android:strokeAlpha="0.92"
            android:strokeWidth="2.5"
            android:fillColor="#00000000" />
    </group>

    <!-- Bintang kecil dekoratif -->
    <path
        android:pathData="M30,32 l0.9,2.1 2.1,0.9 -2.1,0.9 -0.9,2.1 -0.9,-2.1 -2.1,-0.9 2.1,-0.9 z"
        android:fillColor="#FFD9F6FF"
        android:fillAlpha="0.55" />
    <path
        android:pathData="M78,70 l0.7,1.7 1.7,0.7 -1.7,0.7 -0.7,1.7 -0.7,-1.7 -1.7,-0.7 1.7,-0.7 z"
        android:fillColor="#FFD9F6FF"
        android:fillAlpha="0.4" />
</vector>
